# Hedera network: "testnet" or "mainnet"
NEXT_PUBLIC_HEDERA_NETWORK=testnet

# Mirror node REST API base (optional - defaults shown in lib/hedera.ts)
NEXT_PUBLIC_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Demo mode: true shows simulated flash-loan execution when no wallet is connected
NEXT_PUBLIC_DEMO_MODE=true
